<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="group_lm_pos_device_user" model="res.groups">
    <field name="name">POS Device User</field>
  </record>
  <record id="group_lm_pos_device_manager" model="res.groups">
    <field name="name">POS Device Manager</field>
    <field name="implied_ids" eval="[(4, ref('group_lm_pos_device_user'))]"/>
    <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
  </record>

  <record id="rule_lm_pos_device_company" model="ir.rule">
    <field name="name">POS Device: company restriction</field>
    <field name="model_id" ref="model_lm_pos_device"/>
    <field name="domain_force">['|', ('company_id','=',False), ('company_id','in',company_ids)]</field>
    <field name="groups" eval="[(4, ref('group_lm_pos_device_user'))]"/>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>
</odoo>
