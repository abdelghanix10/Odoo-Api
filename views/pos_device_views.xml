<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_lm_pos_device_tree" model="ir.ui.view">
    <field name="name">lm.pos.device.tree</field>
    <field name="model">lm.pos.device</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="device_uuid"/>
        <field name="company_id"/>
        <field name="pos_config_id"/>
        <field name="user_id"/>
        <field name="token_last4"/>
        <field name="active"/>
        <field name="last_seen_at"/>
        <field name="last_sync_at"/>
      </list>
    </field>
  </record>
  <record id="view_lm_pos_device_form" model="ir.ui.view">
    <field name="name">lm.pos.device.form</field>
    <field name="model">lm.pos.device</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_regenerate_token" string="Regenerate Token" type="object" class="oe_highlight"/>
        </header>
        <sheet>
          <group>
            <group>
              <field name="name"/>
              <field name="device_uuid"/>
              <field name="active"/>
              <field name="company_id"/>
            </group>
            <group>
              <field name="pos_config_id"/>
              <field name="user_id"/>
              <field name="token_last4" readonly="1"/>
              <field name="last_seen_at" readonly="1"/>
              <field name="last_sync_at" readonly="1"/>
            </group>
          </group>
          <group>
            <field name="notes"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_lm_pos_device" model="ir.actions.act_window">
    <field name="name">POS Devices</field>
    <field name="res_model">lm.pos.device</field>
    <field name="view_mode">list,form</field>
  </record>
  <menuitem id="menu_lm_pos_api_root" name="Windows POS API" parent="point_of_sale.menu_point_root" sequence="50" groups="point_of_sale.group_pos_manager"/>
  <menuitem id="menu_lm_pos_device" name="POS Devices" parent="menu_lm_pos_api_root" action="action_lm_pos_device" sequence="10" groups="point_of_sale.group_pos_manager"/>
</odoo>
